# Servicio de producción de la Taberna como unidad de systemd de usuario.
# Instalación y actualización: sección «Producción (mint-node)» del README.
[Unit]
Description=Taberna del Aventurero Desafortunado (producción)
After=network-online.target
Wants=network-online.target

[Service]
# Checkout principal. WorkingDirectory toma el resto de la línea como ruta, así que el
# espacio de «Coding projects» va tal cual, sin comillas.
WorkingDirectory=%h/Projects/Coding projects/taberna-del-aventurero-desafortunado
Environment=HOST=0.0.0.0
Environment=PORT=4321
Environment=DATA_DIR=%h/.local/share/taberna/personajes
# systemd no carga nvm: ruta absoluta al Node instalado. Cámbiala si cambia la versión.
ExecStart=%h/.nvm/versions/node/v26.12.0/bin/node dist/server/entry.mjs
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
