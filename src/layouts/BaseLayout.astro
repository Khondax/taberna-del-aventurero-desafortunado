---
// Estructura común: barra lateral con la mesa y sus personajes, cabecera y contenido.
// El slot `actions` añade elementos a la derecha de la cabecera.
import { Font } from 'astro:assets';
import '../styles/global.css';
import { campaign } from '../config';
import { characterLevel, classText } from '../lib/sheet';
import { listSheets } from '../lib/store';

interface Props {
  title?: string;
  /** Ruta de migas en la cabecera, después del nombre de la campaña. */
  crumb: string;
}
const { title, crumb } = Astro.props;
const sheets = await listSheets();
const current = Astro.url.pathname;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Fichas y grimorios para tus partidas de D&D 2024." />
    <title>{title ? `${title} · La Taberna` : 'La Taberna del Aventurero Desafortunado'}</title>
    <Font cssVariable="--font-garamond" />
    <Font cssVariable="--font-hanken" />
    <Font cssVariable="--font-mono" />
  </head>
  <body>
    <div class="app-shell">
      <aside class="sidebar">
        <a class="brand" href="/"><div class="brand-mark" aria-hidden="true">✦</div><div><strong>Grimorio</strong><small>& Crónicas</small></div></a>
        <nav aria-label="Mesa y personajes">
          <div class="sidebar-label">Mesa</div>
          <a class="nav-item" href="/" aria-current={current === '/' ? 'page' : undefined}><strong>Vista del máster</strong></a>
          <div class="sidebar-label">Personajes</div>
          {sheets.map((entry) => 'sheet' in entry && (
            <a class="nav-item" href={`/personajes/${entry.slug}`} aria-current={current === `/personajes/${entry.slug}` ? 'page' : undefined}>
              <strong>{entry.sheet.character.name}</strong><small>{classText(entry.sheet.character)} · nivel {characterLevel(entry.sheet.character)}</small>
            </a>
          ))}
          <a class="nav-item" href="/nueva-ficha" aria-current={current === '/nueva-ficha' ? 'page' : undefined}><strong>＋ Nueva ficha</strong></a>
        </nav>
        <div class="table-card"><small>Mesa activa</small><strong>{campaign.name}</strong><small>{sheets.length} aventureros</small></div>
      </aside>
      <main class="main">
        <header class="topbar">
          <span class="crumb">{campaign.name} / {crumb}</span>
          <div class="top-actions"><slot name="actions" /></div>
        </header>
        <div class="content"><slot /></div>
      </main>
    </div>
  </body>
</html>
