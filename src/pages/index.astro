---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout>
  <div class="app-shell">
    <aside class="sidebar">
      <div class="brand"><div class="brand-mark">✦</div><div><strong>Grimorio</strong><small>& Crónicas</small></div></div>
      <div><div class="sidebar-label">Tu mesa</div><nav class="nav-list" aria-label="Navegación principal">
        <button class="nav-button active" data-nav="sheet"><span class="nav-icon">⌂</span><span>Mi ficha</span></button>
        <button class="nav-button" data-nav="spellbook"><span class="nav-icon">✧</span><span>Grimorio</span></button>
        <button class="nav-button" data-nav="inventory"><span class="nav-icon">◇</span><span>Inventario</span></button>
        <button class="nav-button" data-nav="history"><span class="nav-icon">◷</span><span>Historial</span></button>
      </nav></div>
      <div class="sidebar-spacer"></div>
      <div class="table-card"><small>Mesa activa</small><strong>Las minas de Phandelver</strong><small style="margin-top:8px">4 aventureros · privado</small></div>
      <button class="nav-button"><span class="nav-icon">⚙</span><span>Ajustes</span></button>
    </aside>
    <main class="main">
      <header class="topbar"><span class="crumb">LAS MINAS DE PHANDELVER / FICHA DE PERSONAJE</span><div class="top-actions"><span class="save-state" id="saveState">● Guardado hace un momento</span><div class="avatar">AM</div></div></header>
      <div class="content">
        <div class="title-row"><div><div class="eyebrow">Compañero de mesa · nivel 5</div><h1>La ficha de Arannis</h1></div><button class="button primary" id="openWizard">＋ Subir de nivel</button></div>
        <div class="tab-bar" role="tablist"><button class="tab active" data-tab="sheet">Resumen</button><button class="tab" data-tab="spellbook">Grimorio</button><button class="tab" data-tab="inventory">Inventario</button><button class="tab" data-tab="history">Historial de cambios</button></div>
        <section class="tab-panel active" data-panel="sheet"><div class="sheet-grid">
          <article class="panel hero-panel"><div class="panel-body"><div class="character-head"><div class="character-meta"><div class="portrait" aria-label="Retrato de Arannis"></div><div><div class="eyebrow">Elfo · Mago</div><div class="character-name">Arannis Valebright</div><div class="character-sub">Erudito · Neutral bueno · 1.240 PX</div></div></div><div class="level-badge"><strong>05</strong><span>Nivel</span></div></div>
            <div class="stat-strip"><div class="stat-box"><small>Clase de armadura</small><strong>14</strong></div><div class="stat-box"><small>Iniciativa</small><strong>+2</strong></div><div class="stat-box"><small>Velocidad</small><strong>9 m</strong></div><div class="stat-box"><small>Percepción</small><strong>13</strong></div></div>
            <div class="bar-label"><span>Puntos de golpe</span><strong id="hpLabel">28 / 32</strong></div><div class="bar"><span id="hpBar" style="width:87.5%"></span></div>
            <div class="bar-label"><span>Dados de golpe</span><strong>3 / 5 · d6</strong></div><div class="bar blue"><span style="width:60%"></span></div>
            <div class="bar-label"><span>Experiencia</span><strong>1.240 / 6.500 PX</strong></div><div class="bar gold"><span style="width:19%"></span></div>
            <div class="section-heading"><h3>Características</h3><span>bonificadores</span></div><div class="ability-grid"><div class="ability"><small>Fuerza</small><strong>+0</strong></div><div class="ability"><small>Destreza</small><strong>+2</strong></div><div class="ability"><small>Constitución</small><strong>+1</strong></div><div class="ability"><small>Inteligencia</small><strong>+4</strong></div><div class="ability"><small>Sabiduría</small><strong>+1</strong></div><div class="ability"><small>Carisma</small><strong>-1</strong></div></div>
            <div class="quick-actions"><button class="button secondary" id="damageBtn">− 1d6 daño</button><button class="button secondary" id="healBtn">＋ Curar 1d6</button><button class="button primary" id="rollBtn">⚄ Tirada rápida</button></div>
          </div></article>
          <aside class="panel"><div class="panel-header"><h2>Rasgos destacados</h2><span class="tag">3 activos</span></div><div class="panel-body"><div class="feature-list"><div class="feature"><strong>Recuperación arcana</strong><p>Recupera espacios de conjuro durante un descanso corto.</p></div><div class="feature"><strong>Visión en la oscuridad</strong><p>Alcanzas 18 metros en oscuridad como si fuera penumbra.</p></div><div class="feature"><strong>Erudito del evocador</strong><p>El oro y el tiempo para copiar conjuros de evocación se reducen a la mitad.</p></div></div></div></aside>
          <aside class="panel"><div class="panel-header"><h2>Recursos rápidos</h2><button class="button ghost" id="restBtn">Descansar</button></div><div class="panel-body"><div class="item"><div><strong>Espacios de nivel 1</strong><small>Reponer en descanso largo</small></div><div class="tag">3 / 4</div></div><div class="item"><div><strong>Espacios de nivel 2</strong><small>Reponer en descanso largo</small></div><div class="tag">2 / 3</div></div><div class="item"><div><strong>Recuperación arcana</strong><small>Reponer en descanso corto</small></div><div class="tag">Disponible</div></div><div class="item"><div><strong>Componentes</strong><small>Bolsa de componentes</small></div><div class="tag">✓ Lista</div></div></div></aside>
        </div></section>
        <section class="tab-panel" data-panel="spellbook"><div class="sheet-grid"><article class="panel"><div class="panel-header"><div><div class="eyebrow">Consulta rápida</div><h2>Grimorio de Arannis</h2></div><button class="button secondary">＋ Añadir conjuro</button></div><div class="panel-body"><input class="note-area" style="min-height:auto;height:42px;resize:none" placeholder="Buscar en tus conjuros…" /><div class="section-heading"><h3>Conjuros preparados</h3><span>8 preparados</span></div><div class="item-list"><div class="item"><div><strong>Proyectil mágico</strong><small>Nivel 1 · Evocación · 1 acción</small></div><span class="tag">Preparado</span></div><div class="item"><div><strong>Escudo</strong><small>Nivel 1 · Abjuración · Reacción</small></div><span class="tag">Preparado</span></div><div class="item"><div><strong>Rayo abrasador</strong><small>Nivel 2 · Evocación · 1 acción</small></div><span class="tag">Preparado</span></div><div class="item"><div><strong>Invisibilidad</strong><small>Nivel 2 · Ilusión · 1 acción</small></div><span class="tag">Preparado</span></div></div></div></article><aside class="panel"><div class="panel-header"><h2>Espacios</h2></div><div class="panel-body"><div class="stat-strip"><div class="stat-box"><small>Nivel 1</small><strong>●●●○</strong></div><div class="stat-box"><small>Nivel 2</small><strong>●●○</strong></div></div><p style="color:var(--muted);font-size:13px">Los espacios se restauran con un descanso largo.</p></div></aside></div></section>
        <section class="tab-panel" data-panel="inventory"><div class="panel"><div class="panel-header"><div><div class="eyebrow">Carga actual · 18,4 / 45 kg</div><h2>Inventario</h2></div><button class="button secondary">＋ Añadir objeto</button></div><div class="panel-body"><input class="note-area" style="min-height:auto;height:42px;resize:none" placeholder="Buscar equipo, objetos y tesoro…" /><div class="item-list"><div class="item"><div><strong>Bastón de mago</strong><small>Arma · sintonizado · 1 kg</small></div><span class="tag">Equipado</span></div><div class="item"><div><strong>Libro de conjuros</strong><small>Foco arcano · 1 kg</small></div><span class="tag">Equipado</span></div><div class="item"><div><strong>Poción de curación</strong><small>Consumible · 0,5 kg</small></div><span class="tag">× 2</span></div><div class="item"><div><strong>Ojo de águila</strong><small>Objeto maravilloso · casero</small></div><span class="tag">× 1</span></div></div></div></div></section>
        <section class="tab-panel" data-panel="history"><div class="sheet-grid"><article class="panel"><div class="panel-header"><div><div class="eyebrow">Trazabilidad de la ficha</div><h2>Historial de cambios</h2></div><span class="tag">Solo tú</span></div><div class="panel-body"><div class="item-list"><div class="item"><div><strong>Subida a nivel 5</strong><small>Hoy · Elegiste Rayo abrasador y +2 Inteligencia</small></div><span class="tag">Confirmado</span></div><div class="item"><div><strong>Descanso corto</strong><small>Ayer · Recuperación arcana disponible</small></div><span class="tag">Automático</span></div><div class="item"><div><strong>Inventario actualizado</strong><small>12 mar · Añadida Poción de curación × 2</small></div><span class="tag">Editado</span></div></div></div></article><aside class="panel"><div class="panel-header"><h2>Nota del director</h2><span class="tag">Privada</span></div><div class="panel-body"><textarea class="note-area" id="directorNote" placeholder="Escribe una nota visible solo para el director…">El mapa de la torre está en tu mochila.</textarea><button class="button primary" style="margin-top:12px" id="saveNote">Guardar nota</button></div></aside></div></section>
      </div>
    </main>
  </div>
  <div class="modal hidden" id="wizardModal" role="dialog" aria-modal="true" aria-labelledby="wizardTitle"><div class="modal-card"><div class="panel-header"><div><div class="eyebrow">Progreso del personaje · paso <span id="stepNumber">1</span> de 3</div><h2 id="wizardTitle">Subir de nivel a Arannis</h2></div><button class="button ghost" id="closeWizard" aria-label="Cerrar">×</button></div><div class="panel-body"><div class="wizard-step active" data-step="1"><p>Elige cómo quieres asignar tus mejoras de nivel 6. Puedes editarlo más adelante.</p><div class="wizard-options"><button class="option selected">＋2 Inteligencia <small>Tu modificador pasa a +5</small></button><button class="option">Dote: Observador <small>Ventaja en Percepción pasiva</small></button></div></div><div class="wizard-step" data-step="2"><p>Selecciona un nuevo conjuro para añadir a tu grimorio.</p><div class="wizard-options"><button class="option selected">Rayo de escarcha <small>Truco · Evocación · 1 acción</small></button><button class="option">Imagen múltiple <small>Nivel 2 · Ilusión · 1 acción</small></button></div></div><div class="wizard-step" data-step="3"><p>Revisa los cambios antes de confirmarlos. Todo quedará registrado en tu historial.</p><div class="feature"><strong>Nivel 6 · Mago</strong><p>+2 Inteligencia · Nuevo conjuro: Rayo de escarcha · Puntos de golpe máximos +4</p></div></div><div class="wizard-actions"><button class="button ghost hidden" id="wizardBack">Atrás</button><button class="button primary" id="wizardNext">Continuar</button></div></div></div></div>
  <script is:inline>
    const tabs = [...document.querySelectorAll('[data-tab]')];
    const panels = [...document.querySelectorAll('[data-panel]')];
    const setTab = (name) => { tabs.forEach((tab) => tab.classList.toggle('active', tab.dataset.tab === name)); panels.forEach((panel) => panel.classList.toggle('active', panel.dataset.panel === name)); };
    tabs.forEach((tab) => tab.addEventListener('click', () => setTab(tab.dataset.tab)));
    document.querySelectorAll('[data-nav]').forEach((button) => button.addEventListener('click', () => { setTab(button.dataset.nav); document.querySelectorAll('.nav-button').forEach((item) => item.classList.toggle('active', item === button)); }));
    let hp = 28; const hpLabel = document.querySelector('#hpLabel'); const hpBar = document.querySelector('#hpBar');
    const changeHp = (delta) => { hp = Math.max(0, Math.min(32, hp + delta)); hpLabel.textContent = `${hp} / 32`; hpBar.style.width = `${hp / 32 * 100}%`; document.querySelector('#saveState').textContent = '● Guardado ahora'; };
    document.querySelector('#damageBtn').addEventListener('click', () => changeHp(-4)); document.querySelector('#healBtn').addEventListener('click', () => changeHp(4));
    document.querySelector('#rollBtn').addEventListener('click', () => { const total = Math.floor(Math.random() * 20) + 1 + 4; alert(`Inteligencia: d20 + 4 = ${total}`); });
    document.querySelector('#restBtn').addEventListener('click', () => { hp = 32; hpLabel.textContent = '32 / 32'; hpBar.style.width = '100%'; alert('Descanso largo preparado: revisa los recursos antes de confirmar.'); });
    document.querySelector('#saveNote').addEventListener('click', (event) => { event.target.textContent = 'Guardado'; document.querySelector('#saveState').textContent = '● Nota guardada ahora'; });
    const modal = document.querySelector('#wizardModal'); let step = 1; const renderStep = () => { document.querySelectorAll('.wizard-step').forEach((item) => item.classList.toggle('active', item.dataset.step == step)); document.querySelector('#stepNumber').textContent = step; document.querySelector('#wizardBack').classList.toggle('hidden', step === 1); document.querySelector('#wizardNext').textContent = step === 3 ? 'Confirmar subida' : 'Continuar'; };
    document.querySelector('#openWizard').addEventListener('click', () => { modal.classList.remove('hidden'); step = 1; renderStep(); }); document.querySelector('#closeWizard').addEventListener('click', () => modal.classList.add('hidden')); document.querySelector('#wizardBack').addEventListener('click', () => { step--; renderStep(); }); document.querySelector('#wizardNext').addEventListener('click', (event) => { if (step < 3) { step++; renderStep(); } else { modal.classList.add('hidden'); event.target.textContent = 'Guardado'; document.querySelector('#saveState').textContent = '● Nivel 6 guardado ahora'; } });
    document.querySelectorAll('.option').forEach((option) => option.addEventListener('click', () => { option.parentElement.querySelectorAll('.option').forEach((item) => item.classList.remove('selected')); option.classList.add('selected'); }));
  </script>
</BaseLayout>
